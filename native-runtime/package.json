{
  "name": "nullkode-native-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "NullKode Native engine: one Expo / React Native app that renders any published NullKode app from its compiled native spec.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist-web && node scripts/copy-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.5.0",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "qrcode-generator": "1.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-maps"
        ]
      }
    }
  }
}
