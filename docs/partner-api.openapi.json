{
  "openapi": "3.1.0",
  "info": {
    "title": "Partner API",
    "version": "1.0.0",
    "description": "Lets another service create accounts, sign people in, plan, build and publish apps, and read AI usage on their behalf. See docs/partner-api.md for the full guide.",
    "license": {
      "name": "See the repository's LICENSE"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001/api/partner/v1",
      "description": "Same server (keys set to \"this server only\")"
    },
    {
      "url": "{baseUrl}/api/partner/v1",
      "description": "Public address (keys with an IP allowlist)",
      "variables": {
        "baseUrl": {
          "default": "https://studio.example.com"
        }
      }
    }
  ],
  "security": [
    {
      "partnerKey": []
    }
  ],
  "tags": [
    {
      "name": "users"
    },
    {
      "name": "sso"
    },
    {
      "name": "build"
    },
    {
      "name": "publish"
    },
    {
      "name": "usage"
    }
  ],
  "paths": {
    "/users": {
      "post": {
        "tags": [
          "users"
        ],
        "operationId": "createUser",
        "summary": "Create a person in the key's scope, or return them if they already are in it",
        "description": "Needs the users permission. An email address that belongs to an account outside the key's scope is refused with 409 email_taken; accounts are never taken over.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              },
              "example": {
                "email": "ana@example.com",
                "name": "Ana Lima",
                "plan": "FREE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already in the key's scope (unchanged).",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "201": {
            "description": "Created.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "email_taken (the address has an account this key doesn't manage), or idempotency_in_progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "idempotency_key_reused: this Idempotency-Key was used for a different request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      },
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "listUsers",
        "summary": "People in the key's scope, newest first",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Items per page."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The nextCursor of the previous page."
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only this address."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of people.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "nextCursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "getUser",
        "summary": "One person",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User id."
          }
        ],
        "responses": {
          "200": {
            "description": "The person.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/users/{id}/projects": {
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "listUserProjects",
        "summary": "A person's apps with live, preview and editor links",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User id."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Items per page."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The nextCursor of the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of apps.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "nextCursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/sso": {
      "post": {
        "tags": [
          "sso"
        ],
        "operationId": "createSignInLink",
        "summary": "A one-time sign-in link (works once, for 60 seconds)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SsoRequest"
              },
              "example": {
                "userId": "clx1abc",
                "to": "/projects/clx9xyz/pages"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The link. Open it in the person's browser.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SsoLink"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/plan": {
      "post": {
        "tags": [
          "build"
        ],
        "operationId": "planApp",
        "summary": "Propose an app plan for a person to review",
        "description": "Same checks as the studio: the person's AI allowance must not be used up (planning itself isn't charged) and plans are limited to 30 an hour per person. Takes up to 6 reference images (`images`), or a `referenceId`. Refused with 422 build_not_allowed when the build rule applies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              },
              "example": {
                "userId": "clx1abc",
                "prompt": "A booking site for a small yoga studio"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Started. Poll GET /runs/{runId}.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStarted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "413": {
            "$ref": "#/components/responses/ImageTooLarge"
          },
          "422": {
            "$ref": "#/components/responses/BuildNotAllowed"
          },
          "409": {
            "description": "idempotency_in_progress: a request with this Idempotency-Key is still running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/builds": {
      "post": {
        "tags": [
          "build"
        ],
        "operationId": "buildApp",
        "summary": "Build an app for a person",
        "description": "Charges one AI action to the person (refunded if the build fails). Poll GET /runs/{runId}, or configure a webhook on the key. Takes up to 6 reference images (`images`), or a `referenceId`. Refused with 422 build_not_allowed when the build rule applies.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuildRequest"
              },
              "example": {
                "userId": "clx1abc",
                "prompt": "A booking site for a small yoga studio"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Started.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStarted"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "idempotency_in_progress: a request with this Idempotency-Key is still running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/BuildNotAllowed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "413": {
            "$ref": "#/components/responses/ImageTooLarge"
          }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "tags": [
          "build"
        ],
        "operationId": "getRun",
        "summary": "A plan or build: status, progress and outcome (kept 7 days)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Run id."
          }
        ],
        "responses": {
          "200": {
            "description": "The run.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "run": {
                      "$ref": "#/components/schemas/Run"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/projects/{id}/publish": {
      "post": {
        "tags": [
          "publish"
        ],
        "operationId": "publishProject",
        "summary": "Publish an app's current draft",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "App id."
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Published.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "version": {
                      "type": "integer"
                    },
                    "project": {
                      "$ref": "#/components/schemas/Project"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "idempotency_in_progress: a request with this Idempotency-Key is still running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "idempotency_key_reused: this Idempotency-Key was used for a different request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/usage": {
      "get": {
        "tags": [
          "usage"
        ],
        "operationId": "getUsage",
        "summary": "This month's AI actions, in total and per person",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Items per page."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The nextCursor of the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "Usage.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getSpec",
        "summary": "This description",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "partnerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A partner key (nk_live_...), made under Admin → Partner API or Reseller → Partner API."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": "Send a unique value (a UUID) to make retries safe: a repeat within 24 hours returns the first answer (with Idempotent-Replayed: true) instead of doing it again."
      }
    },
    "headers": {
      "RateLimitLimit": {
        "schema": {
          "type": "integer"
        },
        "description": "Requests allowed in the current window."
      },
      "RateLimitRemaining": {
        "schema": {
          "type": "integer"
        },
        "description": "Requests left in the window."
      },
      "RateLimitReset": {
        "schema": {
          "type": "integer"
        },
        "description": "When the window resets (Unix seconds)."
      },
      "RequestId": {
        "schema": {
          "type": "string"
        },
        "description": "Quote this when reporting a problem."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "invalid_request, invalid_json, invalid_idempotency_key; with reference images also images_not_supported, image_type, too_many_images, image_fetch_failed, references_not_found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "unauthorized: missing, unknown or revoked key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "network_not_allowed, permission_denied, suspended, user_suspended, seats_full, plan_limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "not_found: no such id, or it is outside the key's scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "rate_limited or ai_quota_exceeded. Retry-After says when to try again (rate_limited).",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Internal": {
        "description": "internal.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ImageTooLarge": {
        "description": "image_too_large: a reference image is over 5 MB.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BuildNotAllowed": {
        "description": "build_not_allowed: the platform doesn't build apps similar to NullKode LLC's products (docs/partner-api.md, \"The build rule\"). The message is the sentence to show the person, in their language. (On POST /builds and POST /plan, idempotency_key_reused also answers 422.)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "build_not_allowed",
                "message": "I can't build apps similar to NullKode LLC's NullKode platform, IgniteUps.ai, or any AI tools built by NullKode LLC."
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "not_found"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "STARTER",
              "PRO",
              "TEAM"
            ],
            "default": "FREE",
            "description": "Only used when the account is created."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "plan",
          "suspended",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "type": "string"
          },
          "suspended": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActiveAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "UserResult": {
        "type": "object",
        "required": [
          "user",
          "created"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "created": {
            "type": "boolean"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "app",
              "design"
            ]
          },
          "published": {
            "type": "boolean"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "links": {
            "type": "object",
            "properties": {
              "live": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Public address; null until published."
              },
              "preview": {
                "type": "string",
                "description": "Needs the person signed in."
              },
              "editor": {
                "type": "string",
                "description": "Needs the person signed in."
              }
            }
          },
          "paths": {
            "type": "object",
            "description": "The same pages as paths, to use as \"to\" in POST /sso.",
            "properties": {
              "preview": {
                "type": "string"
              },
              "editor": {
                "type": "string"
              },
              "overview": {
                "type": "string"
              }
            }
          }
        }
      },
      "SsoRequest": {
        "type": "object",
        "required": [
          "userId"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "default": "/dashboard",
            "description": "A path on this site (starting with a single /)."
          }
        }
      },
      "SsoLink": {
        "type": "object",
        "required": [
          "url",
          "expiresAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "…/partner-sso#t=<ticket>"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlanRequest": {
        "type": "object",
        "required": [
          "userId",
          "prompt"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "locale": {
            "type": "string",
            "description": "The app's language, e.g. \"es\"."
          },
          "change": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000,
            "description": "Revise `previous` with this change."
          },
          "previous": {
            "type": "object",
            "description": "A plan from a previous run, with `change`."
          },
          "images": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/ReferenceImage"
            },
            "description": "Up to 6 reference images of how the app should look. Reading them is one AI action. Counted in the Idempotency-Key's request."
          },
          "referenceId": {
            "type": "string",
            "description": "A `referenceId` from an earlier plan or build, to reuse its images (instead of `images`)."
          }
        }
      },
      "BuildRequest": {
        "type": "object",
        "required": [
          "userId",
          "prompt"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "plan": {
            "type": "object",
            "description": "A reviewed plan (from a plan run) to build exactly."
          },
          "locale": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/ReferenceImage"
            },
            "description": "Up to 6 reference images of how the app should look. Reading them is one AI action. Counted in the Idempotency-Key's request."
          },
          "referenceId": {
            "type": "string",
            "description": "A `referenceId` from an earlier plan or build, to reuse its images (instead of `images`)."
          }
        }
      },
      "RunStarted": {
        "type": "object",
        "required": [
          "runId"
        ],
        "properties": {
          "runId": {
            "type": "string"
          },
          "referenceId": {
            "type": "string",
            "description": "When images were sent: their id, for revisions and the build."
          }
        }
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "plan",
              "build"
            ]
          },
          "userId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "success",
              "error"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest progress, in the person's language."
          },
          "progress": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "plan": {
            "type": [
              "object",
              "null"
            ],
            "description": "Plan runs: the proposed plan (pass it to POST /builds)."
          },
          "project": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Project"
              },
              {
                "type": "null"
              }
            ],
            "description": "Successful builds: the new app."
          },
          "references": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Send as referenceId to reuse the images."
                  },
                  "count": {
                    "type": "integer"
                  },
                  "brief": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/VisualBrief"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "The run's reference images, if any."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "build_not_allowed",
              "failed",
              null
            ],
            "description": "On error: build_not_allowed when the build rule stopped the run, else failed."
          },
          "refunded": {
            "type": "boolean",
            "description": "A failed build's AI action was given back."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "examples": [
              "2026-10"
            ]
          },
          "resetsAt": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "reseller",
                  "platform"
                ]
              },
              "resellerId": {
                "type": "string"
              },
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "users": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string"
                    },
                    "used": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              },
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "description": "POSTed to the key's webhook address when a build it started ends. Headers: X-NK-Event, X-NK-Delivery, X-NK-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, \"<t>.<raw body>\")>.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "build.succeeded",
              "build.failed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "attempt": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "properties": {
              "run": {
                "$ref": "#/components/schemas/Run"
              }
            }
          }
        }
      },
      "ReferenceImage": {
        "type": "object",
        "description": "A reference image (concept art, a sketch, a screenshot, a mood board): exactly one of `url` or `data`. At most 5 MB; PNG, JPEG, WebP or GIF (checked from the file's bytes). Shrunk to at most 1600 px and kept privately for 7 days after its last use.",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "A public https:// link to the image."
          },
          "data": {
            "type": "string",
            "description": "The image: a data: URL or plain base64."
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "VisualBrief": {
        "type": "object",
        "description": "What the AI saw in the reference images.",
        "properties": {
          "summary": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hex": {
                  "type": "string",
                  "examples": [
                    "#1f2937"
                  ]
                },
                "role": {
                  "type": "string",
                  "examples": [
                    "background",
                    "surface",
                    "primary",
                    "accent",
                    "text",
                    "muted",
                    "border"
                  ]
                }
              }
            }
          },
          "fonts": {
            "type": "object",
            "properties": {
              "display": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "style": {
                "type": "string"
              }
            }
          },
          "mood": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "imageIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "suggestedTheme": {
            "type": [
              "string",
              "null"
            ],
            "description": "The closest built-in look."
          }
        }
      }
    }
  },
  "webhooks": {
    "buildFinished": {
      "post": {
        "summary": "A build started with this key ended",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx stops the retries."
          }
        }
      }
    }
  }
}
