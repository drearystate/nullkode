{
  "name": "nullkode",
  "version": "0.1.0",
  "description": "Open-source, self-hostable AI no-code platform. Build full web apps — visual editor, real databases, server-side flows, hosting and custom domains — from natural-language prompts.",
  "keywords": [
    "no-code",
    "low-code",
    "ai",
    "claude",
    "openai",
    "agent",
    "nextjs",
    "self-hosted",
    "open-source",
    "app-builder"
  ],
  "license": "MIT",
  "homepage": "https://github.com/drearystate/nullkode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drearystate/nullkode.git"
  },
  "bugs": {
    "url": "https://github.com/drearystate/nullkode/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001 -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "designer:build": "pnpm -C apps/designer-renderer build",
    "postinstall": "prisma generate",
    "check:js": "tsx scripts/check-generated-js.ts",
    "test:e2e": "tsx scripts/check-generated-js.ts && tsx scripts/e2e-resellers.ts && tsx scripts/e2e-publishing.ts && tsx scripts/e2e-push.ts && tsx scripts/e2e-security.ts && tsx scripts/e2e-data.ts && node scripts/smoke-install.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@react-oauth/google": "^0.12.1",
    "argon2": "^0.41.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "googleapis": "^144.0.0",
    "grapesjs": "^0.22.15",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-navbar": "^1.0.2",
    "grapesjs-parser-postcss": "1.0.3",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.3",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.0.9",
    "next": "15.1.11",
    "openai": "^6.34.0",
    "pg": "^8.13.1",
    "pptxgenjs": "4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reactflow": "^11.11.4",
    "resend": "^6.10.0",
    "stripe": "^17.4.0",
    "tailwind-merge": "^2.6.0",
    "undici": "7.25.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
