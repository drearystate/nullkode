# =============================================================================
# Nullkode environment variables
# =============================================================================
# Copy this file to `.env`, then fill in at minimum the REQUIRED block below.
# Optional blocks can stay commented out; their features cleanly disable
# themselves when the relevant variables aren't set.
#
# This file is checked into git. The real `.env` must NEVER be committed.
# =============================================================================


# -- REQUIRED -----------------------------------------------------------------

# Postgres connection string. Local dev: postgres://nullkode:nullkode@127.0.0.1:5432/nullkode
DATABASE_URL=postgres://nullkode:nullkode@127.0.0.1:5432/nullkode

# Random 32+ character string. Used for:
#   - Session cookie HMAC
#   - AES-GCM encryption of stored provider API keys in the Setting table
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-secure-random-string

# The guided installer generates these. For manual setup use independent random values.
INSTALL_TOKEN=replace-me-with-a-secure-random-setup-code
DB_PASSWORD=replace-me-with-a-secure-random-database-password
APP_PORT=3001
BIND_ADDRESS=127.0.0.1

# Public base URL of your deployment. Used in:
#   - Absolute links in emails / OAuth callbacks
#   - Stripe redirect URLs
# Example: https://nullkode.example.com
PUBLIC_BASE_URL=http://localhost:3001


# -- AI PROVIDERS (configure at least one) ------------------------------------

# AI is optional. All text AI paths support the configured API or optional CLI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_SCAFFOLD_MODEL=gpt-6-luna
OPENAI_EDIT_MODEL=gpt-6-luna
# Optional cap on output tokens per AI call, for small local models only.
# Leave it unset: page edits and one-shot builds need far more than 8192.
# AI_MAX_OUTPUT_TOKENS=8192
# Compatible hosted or local API; empty uses OpenAI.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# For Qwen, use the exact model ID served by your endpoint, e.g. Qwen/Qwen3.8-27B.
# AI_JSON_MODE=json   # schema | json | text
# AI_STALL_TIMEOUT_MS=120000
# Optional: AI_PROVIDER=claude-cli runs every AI feature (builder, Ask AI,
# Designer) through a locally installed command-line AI agent instead.
# CLAUDE_BIN=/usr/local/bin/claude
# CLAUDE_MODEL=sonnet
# NK_CLAUDE_RUNNER_UID=983
# NK_CLAUDE_RUNNER_GID=979
# NK_CLAUDE_RUNNER_HOME=/home/claude-runner
# NK_CLAUDE_RUNNER_USER=claude-runner

# -- AUTH (optional Google OAuth) ---------------------------------------------

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# -- BILLING (optional Stripe) ------------------------------------------------

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_TEAM=price_xxx


# -- EMAIL (optional) ---------------------------------------------------------

# Invitations, password links and app notifications. Easiest in the browser:
# Administration -> Settings -> Email (with a "send a test email" button).
# These lines are used when nothing is set there. See docs/email.md.
# Any email provider's SMTP server (most providers offer one):
# SMTP_HOST=smtp.example.com
# Port 587 works almost everywhere. Many servers block port 25.
# SMTP_PORT=587
# Empty = automatic; "ssl" for port 465; "starttls" to insist on encryption.
# SMTP_SECURE=
# SMTP_USER=hello@example.com
# SMTP_PASSWORD=
# The sender, optionally with a name: Your Studio <hello@example.com>
# SMTP_FROM=hello@example.com
# Or Resend's API instead of SMTP:
# RESEND_API_KEY=
# DEFAULT_EMAIL_FROM=hello@example.com


# -- IMAGE LIBRARIES (optional) -----------------------------------------------

# Used by the in-editor image picker. Each is optional and falls back to
# the others when one is missing. Without any, users upload their own.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=


# -- PUSH NOTIFICATIONS (optional VAPID) --------------------------------------

# Generate with: pnpm exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=


# -- ADMIN -------------------------------------------------------------------

# Comma-separated email addresses that get auto-promoted to ADMIN on signup.
# ADMIN_EMAILS=you@example.com


# -- SCHEDULED WORKFLOWS AND HOUSEKEEPING ------------------------------------

# Secret token required for /api/cron/* endpoints. Generate with openssl rand.
# CRON_SECRET=
# The app checks for due scheduled workflows every minute by itself. Set 1
# when something else calls /api/cron every minute instead (docker-compose.yml
# sets it, because its scheduler service does that).
# NK_EXTERNAL_SCHEDULER=
# Hour of the day (0-23, server time) for the daily clean-up.
# NK_MAINTENANCE_HOUR=3


# -- HEALTH AND UPDATES --------------------------------------------------------

# /api/health answers 200 when the app and database are fine. With this token,
# /api/health?detail=1 (header "Authorization: Bearer <token>") shows every
# check, for a monitor such as Uptime Kuma. Generate with: openssl rand -hex 32
# HEALTH_TOKEN=
# Before starting, the app checks the database has every table and column it
# needs. refuse = don't start until the database is updated; apply = add
# what's missing first (additive changes only). Docker uses apply; the
# systemd service (docs/deploy/systemd/nullkode.service) defaults to refuse.
# NK_SCHEMA_MODE=


# -- BACKUPS -------------------------------------------------------------------

# With Docker, the backup service makes a backup every night while the app
# keeps running: the database, uploaded files and, once a week, imported
# websites' files. See docs/deploy/RESTORE.md. Make one now: bash scripts/backup.sh
# Time of the nightly backup (24-hour clock, in the TZ time zone). off = no
# nightly backups.
# BACKUP_TIME=03:30
# Time zone for BACKUP_TIME, for example Europe/Berlin. Default UTC.
# TZ=UTC
# Day of the weekly backup that also saves imported websites' files:
# 1 = Monday ... 7 = Sunday.
# BACKUP_WEEKLY_DAY=7
# How many to keep. Backups you make yourself are never deleted automatically.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Where backups go on this computer.
# BACKUP_DIR=./backups
# With a passphrase, each backup includes this .env, encrypted. Without one,
# .env is left out: keep your own copy. Write the passphrase down somewhere
# safe, away from this server; without it the copy can't be opened. Use
# letters, numbers and spaces (Docker reads a "$" in .env as a variable).
# BACKUP_PASSPHRASE=
# Opened after each successful nightly backup, so a monitor (Healthchecks.io,
# an Uptime Kuma push monitor) can warn you when backups stop.
# BACKUP_HEARTBEAT_URL=


# -- ANDROID APK BUILDS (optional) -------------------------------------------

# 1 adds JDK 17 and Google's Android SDK to the Docker image so the Mobile App
# tab can build APKs (about 1.1 GB more, x86-64 hosts only). Setting 1 means
# you accept Google's Android SDK License: https://developer.android.com/studio/terms
# The installer asks and sets this. Apply a manual change: docker compose up -d --build
NULLKODE_ANDROID=0
# Bare-metal installs only; the Docker image sets these. Unset means the default:
# ANDROID_HOME=/opt/android-sdk, JAVA_HOME = the JDK that provides javac on PATH,
# GRADLE_USER_HOME=~/.gradle, ANDROID_USER_HOME=~/.android (holds the key that
# signs every APK; keep it), NK_APK_WORK_DIR=<tmp>/nk-apk.
# ANDROID_HOME=/opt/android-sdk
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64


# -- NATIVE APPS (optional) ---------------------------------------------------
# The studio's phone preview of the native app works on every install. See
# docs/native-apps.md for the rest.

# Docker: 1 adds Node 22 and the native engine's packages to the image (about
# 800 MB more): Expo Go previews on your phone, and (with NULLKODE_ANDROID=1)
# Android store builds of the native app. Apply: docker compose up -d --build
NULLKODE_NATIVE_ENGINE=0
# Phone notifications for native apps go through Expo's push service: the Expo
# project your push credentials (Firebase for Android, an Apple push key for
# iPhone) belong to, and an access token if your Expo account requires one.
# NK_EXPO_PROJECT_ID=
# NK_EXPO_ACCESS_TOKEN=
# Bare-metal: Node.js for the engine's tools when not at /opt/node-22/bin/node.
# NK_NATIVE_NODE=/opt/node-22/bin/node
# Android in the browser (optional emulator service, services/native-emulator):
# the secret it shares with this server, and its address if not 127.0.0.1:8795.
# NK_EMU_SECRET=
# NK_EMU_URL=http://127.0.0.1:8795


# -- WEB ADDRESS AND AUTOMATIC HTTPS (Docker) ---------------------------------

# The installer asks "Do you have a domain name for this server?" and sets
# these. Run it again to change them (NULLKODE_DOMAIN=studio.example.com, or
# none). See START-HERE.md -> "Put it on a public domain".
# HTTPS mode: "https" starts the caddy service in docker-compose.yml. It answers
# on ports 80 and 443 and gets free Let's Encrypt certificates by itself, and
# PUBLIC_BASE_URL is then https://<your domain>. Empty: plain http on
# APP_PORT, for a computer without a domain name.
COMPOSE_PROFILES=
# 1 in HTTPS mode. The home page then says certificates are automatic.
NK_AUTO_TLS=0
# Optional email for certificate notices from Let's Encrypt.
NK_TLS_EMAIL=
# Lets Caddy ask the app which addresses may get a certificate
# (/api/internal/tls-allow). Random, 32+ characters; the installer makes it.
# Generate with: openssl rand -hex 32
NK_TLS_ASK_SECRET=
# Optional: every published app at its own address, https://<app>.<APPS_DOMAIN>.
# Needs one wildcard DNS record, *.APPS_DOMAIN, pointing at this server.
# Recommended when other people build apps here: each app is its own web
# origin, so a bad app can't reach the studio or other apps. A separate domain
# (myapps.site) is even better than a subdomain of the studio's domain
# (apps.example.com). Empty = apps live at <PUBLIC_BASE_URL>/app/<name>.
APPS_DOMAIN=
# Only when a router forwards the public ports 80/443 to other ports here.
# HTTP_PORT=80
# HTTPS_PORT=443
