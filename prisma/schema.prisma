generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  RESELLER
}

enum ResellerStatus {
  ACTIVE
  SUSPENDED
}

enum Plan {
  FREE
  STARTER
  PRO
  TEAM
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum DataSourceKind {
  POSTGRES_INTERNAL
  POSTGRES_EXTERNAL
  GOOGLE_SHEETS
}

enum FlowTriggerKind {
  HTTP
  FORM_SUBMIT
  SCHEDULE
  EVENT
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum ProjectKind {
  EDITOR
  DESIGNER
}

// AI Designer (src/lib/design-studio).

enum DesignerSnapshotType {
  INITIAL
  EDIT
  FORK
}

enum DesignerArtifactType {
  HTML
  REACT
  SVG
}

enum DesignerChatKind {
  USER
  ASSISTANT_TEXT
  TOOL_CALL
  ARTIFACT_DELIVERED
  ERROR
}

enum DesignerFileKind {
  HTML
  JSX
  TSX
  CSS
  JS
  MARKDOWN
  TEXT
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  DESIGN_SYSTEM
  ASSET
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  emailVerified DateTime?
  // Canonical form of `email` (lowercased, gmail dots/+tags stripped). Used to
  // stop one mailbox from farming accounts via address aliases. Deliberately
  // NOT unique — historical rows contain aliases of each other.
  emailNormalized String?
  // Client IP at signup, for per-IP abuse limits. Null for pre-existing rows.
  signupIp      String?
  role          Role     @default(USER)
  lastSeenAt    DateTime?
  // Small per-user UI preferences (e.g. { "helpTips": false }). Kept as
  // loose JSON so adding a preference doesn't need a schema change.
  prefs         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Set when the account belongs to a reseller's client list. Clients see
  // their reseller's brand and billing instead of the platform's.
  resellerId    String?
  // Suspended accounts can't sign in (set by the operator or their reseller).
  suspendedAt   DateTime?

  plan                 Plan               @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(NONE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?

  projects  Project[]
  sessions  Session[]
  accountTokens AccountToken[]
  reseller      Reseller? @relation("ResellerClients", fields: [resellerId], references: [id], onDelete: SetNull)
  ownedReseller Reseller? @relation("ResellerOwner")

  designerDesigns      DesignerDesign[]

  @@index([stripeCustomerId])
  @@index([emailNormalized])
  @@index([signupIp, createdAt])
  @@index([resellerId])
  aiUsage AiUsage[]
  aiRuns  AiRun[]
  games   GameProject[]
}

/**
 * An agency/partner that sells the platform under its own brand. The
 * operator creates resellers and sets their quotas; each reseller brands its
 * own dashboard (optionally on its own domain), invites clients, and bills
 * them on its own Stripe account. Clients are ordinary users with resellerId.
 */
model Reseller {
  id        String         @id @default(cuid())
  ownerId   String         @unique
  name      String
  slug      String         @unique
  status    ResellerStatus @default(ACTIVE)
  // Dashboard host for the reseller's clients, e.g. "apps.agency.com".
  domain           String?   @unique
  domainToken      String?
  domainVerifiedAt DateTime?
  // Brand overrides: tagline, logo/favicon data URLs, colours, support email.
  brand      Json?
  // Stripe account used to bill this reseller's clients (secrets encrypted).
  billing    Json?
  // Plan limits this reseller offers its clients (same shape as plans.limits).
  planLimits Json?
  // Quotas set by the operator. Null = unlimited.
  maxClients Int?
  maxApps    Int?
  // Monthly AI actions across all of this reseller's clients. Null = unlimited.
  maxAiActions Int?
  // Whether new clients can sign themselves up on the reseller's domain.
  allowSignup Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation("ResellerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  clients User[] @relation("ResellerClients")
  partnerKeys PartnerKey[]
}

/// One-time links for account invitations and password resets. Only a hash
/// of the token is stored.
model AccountToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // "invite" | "reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * A proof-of-work ticket handed to a signup form. The row is the only place the
 * challenge exists, so it can be spent exactly once, and the per-IP history
 * doubles as the signup rate limiter.
 */
model AuthChallenge {
  id         String   @id
  purpose    String   @default("signup")
  ip         String
  difficulty Int
  createdAt  DateTime @default(now())
  usedAt     DateTime?

  @@index([ip, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Session {
  id                  String   @id @default(cuid())
  userId              String
  token               String   @unique
  expiresAt           DateTime
  impersonatingUserId String?
  createdAt           DateTime @default(now())
  userAgent           String?
  ip                  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String            @id @default(cuid())
  ownerId     String
  name        String
  slug        String            @unique
  description String?
  visibility  ProjectVisibility @default(PRIVATE)
  kind        ProjectKind       @default(EDITOR)
  published   Boolean           @default(false)
  publishedAt DateTime?
  // The deployment (snapshot of pages, flows and theme) the public site
  // serves. Null for apps published before safe publishing existed: those
  // keep serving their latest saved pages until they publish again.
  liveDeploymentId String?
  /// DNS-safe name for the app's own subdomain (<hostLabel>.<APPS_DOMAIN>).
  hostLabel        String?           @unique
  theme       Json?
  icon        String?
  native      Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages       Page[]
  flows       Flow[]
  datasources DataSource[]
  domains     Domain[]
  deployments Deployment[]
  modules     ProjectModule[]

  @@index([ownerId])
  pushMessages PushMessage[]
  nativePushTokens NativePushToken[]
  androidSigningKey AndroidSigningKey?
}

// ── AI Designer ─────────────────────────────────────────────────────────
// A design is its files (pages and data definitions), the versions saved
// after each change, the conversation, and the builds that ran
// (src/lib/design-studio).

model DesignerDesign {
  id             String                @id @default(cuid())
  userId         String
  // Optional Project (kind=DESIGNER) the design lives under. When set, the
  // design's primary HTML file is mirrored to the project's pages so the
  // existing Nullkode publish/domains/hosting pipeline can serve it.
  projectId      String?
  name           String                @default("Untitled design")
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     DesignerFile[]
  snapshots DesignerSnapshot[]
  chat      DesignerChatRow[]

  @@index([userId])
  @@index([projectId])
}

// Virtual workspace file. Replaces the local-FS workspace that the desktop
// app keeps at <userData>/workspaces/<designId>/.
model DesignerFile {
  id          String           @id @default(cuid())
  designId    String
  path        String           // workspace-relative, normalized with forward slashes
  kind        DesignerFileKind
  content     String           @default("")
  // For binary assets we base64 the content into `content`. `size` stays in bytes.
  size        Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  design DesignerDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, path])
  @@index([designId])
}

model DesignerSnapshot {
  id                String               @id @default(cuid())
  designId          String
  parentId          String?
  type              DesignerSnapshotType
  prompt            String?
  artifactType      DesignerArtifactType
  artifactSource    String               // the actual HTML/JSX/SVG text at this snapshot
  message           String?
  /// Every text file of the design at this version ({ path: content }), so a
  /// version can be restored whole. Older versions only have artifactSource.
  files             Json?
  createdAt         DateTime             @default(now())

  design DesignerDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@index([parentId])
}

// Chat row replayed from the per-design session JSONL in upstream. The
// renderer uses `seq` to order; payload is opaque JSON the renderer parses.
model DesignerChatRow {
  id         Int              @id @default(autoincrement())
  designId   String
  seq        Int
  kind       DesignerChatKind
  payload    Json
  snapshotId String?
  createdAt  DateTime         @default(now())

  design DesignerDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, seq])
  @@index([designId])
}

// LLM provider configured by the user. Maps to the renderer's Settings
// providers list. apiKey is encrypted at rest via the same AES-GCM helper
// the existing Setting table uses.

// One row per user — the full Preferences blob the renderer expects.

// In-progress agent generation. Used by generation-status / cancel.
model DesignerGenerationJob {
  id           String   @id  // matches renderer-supplied generationId
  designId     String
  userId       String
  // "running" | "done" | "error" | "cancelled"
  status       String   @default("running")
  cancelRequested Boolean @default(false)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([designId])
  @@index([userId])
}

model ProjectModule {
  id          String   @id @default(cuid())
  projectId   String
  moduleId    String
  version     String
  config      Json     @default("{}")
  installedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([moduleId])
}

model Page {
  id        String   @id @default(cuid())
  projectId String
  slug      String
  title     String
  isHome    Boolean  @default(false)
  html      String   @default("")
  css       String   @default("")
  components Json?
  styles     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations PageTranslation[]

  @@unique([projectId, slug])
  @@index([projectId])
}

/// A page in one of its app's other languages (multilingual apps,
/// src/lib/app-translations.ts). The page itself holds the app's default
/// language; CSS is shared. Frozen into deployment snapshots on publish.
model PageTranslation {
  id         String   @id @default(cuid())
  pageId     String
  locale     String
  title      String
  html       String   @default("")
  /// Fingerprint of the page (title + html, shared menu left out) this was
  /// made from: when the page changes, the translation needs updating.
  sourceHash String   @default("")
  /// "ai" (made by the AI) or "edited" (changed by the owner since).
  origin     String   @default("ai")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([pageId])
}

model Flow {
  id        String          @id @default(cuid())
  projectId String
  name      String
  slug      String
  trigger   FlowTriggerKind @default(HTTP)
  httpPath  String?
  httpMethod String?        @default("POST")
  schedule  String?
  enabled   Boolean         @default(true)
  graph     Json            @default("{\"nodes\":[],\"edges\":[]}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Built-in scheduler bookkeeping (src/lib/flow/scheduler.ts). Every field
  // is optional or has a default, so adding them never rewrites old rows.
  /// When the flow next runs on its schedule. Null until the scheduler plans it.
  nextRunAt            DateTime?
  lastRunAt            DateTime?
  /// "running" | "ok" | "failed" | "timeout"
  lastStatus           String?
  consecutiveFailures  Int       @default(0)
  /// Why the scheduler stopped running the flow ("failures" | "invalid"); Resume clears it.
  pausedReason         String?
  /// The live deployment nextRunAt was planned from, so a new publish re-plans it.
  scheduleDeploymentId String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    FlowRun[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([trigger, enabled, nextRunAt])
}

model FlowRun {
  id        String   @id @default(cuid())
  flowId    String
  status    String
  input     Json?
  output    Json?
  error     String?
  durationMs Int?
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@index([createdAt])
}

model DataSource {
  id         String         @id @default(cuid())
  projectId  String
  name       String
  kind       DataSourceKind
  config     Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tables  DataTable[]

  @@index([projectId])
}

model DataTable {
  id           String   @id @default(cuid())
  datasourceId String
  name         String
  schema       Json     @default("{\"fields\":[]}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  datasource DataSource @relation(fields: [datasourceId], references: [id], onDelete: Cascade)

  @@unique([datasourceId, name])
  @@index([datasourceId])
}

model Domain {
  id         String       @id @default(cuid())
  projectId  String
  host       String       @unique
  status     DomainStatus @default(PENDING)
  verifyToken String
  createdAt  DateTime     @default(now())
  verifiedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Deployment {
  id        String   @id @default(cuid())
  projectId String
  version   Int
  snapshot  Json
  createdBy String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
}

/// A push notification an app owner sent to their app's subscribers.
/// A phone that turned on notifications in the app's NullKode Native build
/// (POST /api/push/native): its Expo push token. Sent to with the web
/// subscribers (lib/push.ts); a token Expo reports as gone is deleted.
model NativePushToken {
  id         String   @id @default(cuid())
  projectId  String
  token      String
  /// "ios" | "android"
  platform   String   @default("")
  /// The app language the phone chose (multilingual apps).
  locale     String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, token])
  @@index([projectId])
}

model PushMessage {
  id        String   @id @default(cuid())
  projectId String
  title     String
  body      String   @default("")
  url       String?
  sent      Int      @default(0)
  failed    Int      @default(0)
  removed   Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// One AI action (an app build, a Designer run, an Ask-AI edit, an AI flow
/// step…), counted against the plan's monthly allowance. The operator pays
/// the AI bill, so every plan can cap it.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An app build or plan run (src/lib/ai/runs.ts). The live copy is in the
/// server's memory; this row keeps it through restarts: status, the events a
/// reader replays, the result. A run still "running" when the server starts
/// again is marked failed and its AI action (chargeId) refunded. Finished
/// runs are kept 7 days.
model AiRun {
  id          String    @id
  ownerId     String
  // "scaffold" | "plan"
  kind        String
  prompt      String
  // "running" | "success" | "error"
  status      String    @default("running")
  events      Json      @default("[]")
  result      Json?
  // result.projectId, for lookups by app
  projectId   String?
  error       String?
  refunded    Boolean   @default(false)
  // The AiUsage row this run was charged, until it ends (see lib/ai-quota.ts).
  chargeId    String?
  // Who started it, an opaque tag: null = the studio, "partner:<partnerKeyId>" = the partner API.
  source      String?
  // The server process that runs it (host:folder:port), see recoverInterruptedRuns.
  instance    String?
  // Extra facts about the run, e.g. { references: { id, count, brief? } } for
  // reference images (src/lib/ai/references.ts; the files live in
  // uploads/<ownerId>/ai-refs/<id>/ and are deleted with the run).
  meta        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  endedAt     DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([status, heartbeatAt])
  @@index([endedAt])
}

/// A build the platform refused under its build rule (src/lib/ai/build-policy.ts):
/// apps similar to the platform owner's own products. Shown in Admin → Refused builds.
model BuildRefusal {
  id        String   @id @default(cuid())
  // Who asked (no relation: the record outlives a deleted account).
  userId    String?
  // "plan" | "revision" | "build" | "edit" | "section" | "designer"
  kind      String
  // Where it was caught: "rule" (fixed patterns), "ai" (the AI check), "plan", "images", "result"
  stage     String
  // null = the studio, "partner:<partnerKeyId>" = the partner API
  source    String?
  projectId String?
  // The first 500 characters of the request
  prompt    String
  reason    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// The Android upload key that signs an app's Google Play builds (AAB and
/// release APK). The keystore file is in private storage
/// (uploads/.signing/<projectId>/, never under public/); both passwords are
/// encrypted with encryptSecret (src/lib/settings.ts). Replacing the key
/// updates this row, so lastVersionCode keeps counting up: Google Play needs
/// a higher versionCode for every upload.
model AndroidSigningKey {
  id              String   @id @default(cuid())
  projectId       String   @unique
  /// File name inside the project's signing folder.
  file            String
  keyAlias        String
  storePassword   String
  keyPassword     String
  /// Certificate fingerprints, shown to the owner (Play Console lists them too).
  sha256          String
  sha1            String   @default("")
  /// true when the owner uploaded their own key instead of us creating one.
  imported        Boolean  @default(false)
  lastVersionCode Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Partner API keys (src/lib/partner, docs/partner-api.md). Another service
/// manages accounts, signs people in and builds apps through /api/partner/v1.
/// Only a SHA-256 hash of the key is stored; `prefix` (8 characters of the
/// random part, unique) finds the row and is shown in the key lists.
model PartnerKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  hash        String
  /// Scope: one reseller's clients, or (null) the platform's own customers.
  resellerId  String?
  /// { users, sso, build, publish, usage }: booleans, all on by default.
  permissions Json
  /// Empty = same server only. Otherwise IPs/CIDRs matched against X-Real-IP.
  allowedIps  String[]  @default([])
  /// Build-finished callback: URL, encrypted signing secret, private targets allowed (operator only).
  webhook     Json?
  createdById String?
  lastUsedAt  DateTime?
  rotatedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reseller    Reseller? @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  tickets     PartnerSsoTicket[]
  idempotency PartnerIdempotency[]

  @@index([resellerId])
}

/// One-time sign-in tickets from POST /api/partner/v1/sso. `id` is the
/// ticket's SHA-256; tickets live 60 seconds and work once.
model PartnerSsoTicket {
  id        String    @id
  keyId     String
  userId    String
  to        String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  key PartnerKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Saved answers for partner POSTs sent with an Idempotency-Key (24 hours).
model PartnerIdempotency {
  id          String   @id @default(cuid())
  keyId       String
  idemKey     String
  fingerprint String
  /// Null while the first request is still running.
  status      Int?
  body        Json?
  createdAt   DateTime @default(now())

  key PartnerKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([keyId, idemKey])
  @@index([createdAt])
}

// ── Game Studio (src/lib/game-studio) ───────────────────────────────────
// A game is its own source files on one of the engine kits (nk-games), the
// versions saved after every build step, the conversation and the AI jobs
// that build it step by step (they carry on after a restart).

model GameProject {
  id         String    @id @default(cuid())
  ownerId    String
  name       String    @default("Untitled game")
  // "phaser-2d" | "three-3d"
  engine     String
  kitVersion String    @default("1.0.0")
  // "new" | "building" | "ready" | "error"
  status     String    @default("new")
  // The NullKode app the game is published as (a Project of kind DESIGNER).
  projectId  String?
  // The game design brief (genre, core loop, controls, art, chosen assets…).
  plan       Json?
  // The design playbook's genre card the game follows (nk-games/design INDEX.json id), null = core rules only.
  genreId    String?
  // The game's own files as they are now: path -> source.
  files      Json      @default("{}")
  // The newest GameVersion.seq
  seq        Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions GameVersion[]
  jobs     GameJob[]
  chat     GameChat[]
  notes    GameNote[]

  @@index([ownerId])
  @@index([projectId])
}

/// The game after one build step (or a restore): every file, the step it came from and the headless check's result.
model GameVersion {
  id        String   @id @default(cuid())
  gameId    String
  seq       Int
  // path -> source of every file of the game at this version
  files     Json
  stepLabel String
  note      String?
  // "step" | "restore"
  kind      String   @default("step")
  // The headless check: { ok, errors, fps, state, ms } (null = not run)
  check     Json?
  // A small WebP screenshot of the game at this version (from the headless check)
  shot      Bytes?
  createdAt DateTime @default(now())

  game GameProject @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seq])
}

/// A build or a change, run step by step in the background (like DesignerGenerationJob). It survives restarts:
/// its plan, steps and the next step to run are kept here and a restarted server carries on (src/lib/game-studio/engine.ts).
model GameJob {
  id              String    @id
  gameId          String
  userId          String
  // "build" | "change"
  kind            String
  prompt          String
  // "running" | "done" | "error" | "cancelled"
  status          String    @default("running")
  cancelRequested Boolean   @default(false)
  // "Stop after this step": the job ends once the step running now is saved.
  stopAfterStep   Boolean   @default(false)
  // [{ id, label, goal, status: "todo"|"running"|"done"|"error", seq?, error? }]
  steps           Json      @default("[]")
  // index of the next step to run
  stepIndex       Int       @default(0)
  // the AiUsage charge (refunded when nothing was delivered)
  chargeId        String?
  // the server process running it (host:folder:port) and its heartbeat
  instance        String?
  heartbeatAt     DateTime  @default(now())
  resumes         Int       @default(0)
  error           String?
  // { locale, references, phase … }
  meta            Json?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  game GameProject @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([status, heartbeatAt])
}

/// The Game Studio conversation.
model GameChat {
  id         String   @id @default(cuid())
  gameId     String
  seq        Int
  // "user" | "assistant" | "error"
  kind       String
  text       String
  versionSeq Int?
  createdAt  DateTime @default(now())

  game GameProject @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, seq])
}

/// A note the person sent while a build or change was running ("steer while building"). The build rule
/// checks it, a short AI reply answers it at once, and the build loop reads it before every step: the
/// owner's instructions go into the step prompt, ahead of the original plan (src/lib/game-studio/notes.ts).
model GameNote {
  id           String   @id @default(cuid())
  gameId       String
  jobId        String
  userId       String
  // GameChat.seq of the person's message
  chatSeq      Int?
  text         String
  // reference images sent with it: { id, count } (lib/ai/references.ts)
  references   Json?
  // "new" | "checking" | "accepted" | "question" | "refused" | "applied" | "dropped"
  status       String   @default("new")
  // what the quick reply decided: "change" | "question"; newStep = the plan needs a step for it
  kind         String?
  newStep      Boolean  @default(false)
  // the step id it is planned for, and the step (1-based number, label) it was applied in
  planStep     String?
  appliedStep  Int?
  appliedLabel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game GameProject @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([gameId])
}
